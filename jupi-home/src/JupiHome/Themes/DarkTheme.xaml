<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== JUPI DARK THEME (warm, soft, minimal) ====== -->
    <!-- "Jupi after the lights went down." The accent remains recognizable. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1917"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252220"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3833"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E0D6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3988C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A88B6F"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B89B7F"/>
    <SolidColorBrush x:Key="UserMessageBgBrush" Color="#332E2A"/>
    <SolidColorBrush x:Key="UserMessageBorderBrush" Color="#4A443E"/>
    <SolidColorBrush x:Key="AssistantMessageBgBrush" Color="#252220"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#D45C5C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#7DA898"/>

    <!-- Interaction tokens used by style triggers -->
    <SolidColorBrush x:Key="HoverBrush" Color="#332E2A"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3D3833"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#3A3530"/>
    <SolidColorBrush x:Key="DisabledFgBrush" Color="#6E6560"/>

</ResourceDictionary>