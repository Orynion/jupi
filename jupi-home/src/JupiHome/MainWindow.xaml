<Window x:Class="JupiHome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JupiHome.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Jupi Home" Height="700" Width="1100" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Converters -->
        <local:MarkdownToFlowDocumentConverter x:Key="MarkdownConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Conversation list item style -->
        <Style x:Key="ConversationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== REFINED MESSAGE STYLES (No Huge Bubbles) ====== -->
        <Style x:Key="UserMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource UserMessageBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserMessageBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="80,6,16,6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="550"/>
        </Style>

        <Style x:Key="AssistantMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AssistantMessageBgBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,6,0,6"/>
            <Setter Property="Margin" Value="16,6,80,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="550"/>
        </Style>

        <!-- Primary button with paper-plane send interaction -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NewChatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== MESSAGE TEMPLATE WITH REFINED STYLING ====== -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,4">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Edit" Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- User message -->
                <Border Style="{StaticResource UserMessageStyle}" Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   LineHeight="20"
                                   FontFamily="{StaticResource BodyFont}"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0"
                                   FontFamily="{StaticResource BodyFont}"/>
                    </StackPanel>
                </Border>

                <!-- Assistant message -->
                <Border Style="{StaticResource AssistantMessageStyle}" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <FlowDocumentScrollViewer Document="{Binding Content, Converter={StaticResource MarkdownConverter}}"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  IsToolBarVisible="False"
                                                  FontFamily="{StaticResource BodyFont}"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0"
                                   FontFamily="{StaticResource BodyFont}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ====== MUSIC PANEL STYLES ====== -->
        <Style x:Key="MusicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="500"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Empty state template -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <TextBlock Text="Jupi Home" 
                           FontSize="36"
                           FontWeight="Bold"
                           FontFamily="{StaticResource HeadingFont}"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Start a conversation" 
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           FontFamily="{StaticResource BodyFont}"/>
                <TextBlock Text="Ask a question or share your thoughts." 
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="{StaticResource BodyFont}"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar - Conversation history -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with branding -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="J" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   FontFamily="{StaticResource BrandingFont}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,2"/>
                    </StackPanel>
                </Border>

                <!-- New Chat button -->
                <Button Grid.Row="1" 
                        Content="+ New Chat" 
                        Style="{StaticResource NewChatButtonStyle}"
                        Command="{Binding NewChatCommand}" 
                        Margin="12,16,12,12" 
                        Height="36"
                        FontFamily="{StaticResource BodyFont}"/>

                <!-- Conversation list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,8,0,8">
                    <ListBox x:Name="ConversationListBox"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ConversationItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="200"
                                               FontWeight="500"
                                               FontFamily="{StaticResource BodyFont}"/>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM d}'}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               FontFamily="{StaticResource BodyFont}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right side - Main chat area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Header with connection status -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
    <TextBlock Text="Conversation" 
               FontSize="16" 
               FontWeight="500"
               Foreground="{DynamicResource TextPrimaryBrush}"
               FontFamily="{StaticResource BodyFont}"/>
    
</StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        <!-- V0.63: Light/Dark theme toggle -->
                        <Button x:Name="ThemeToggleButton"
                                Click="ThemeToggleButton_Click"
                                ToolTip="Toggle light / dark theme"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,2"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="ThemeToggleIcon" Text="🌙" FontSize="14"/>
                        </Button>
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource BodyFont}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat messages area -->
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ====== MUSIC PANEL (embedded WebView2 YouTube player) ====== -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12"
                            Visibility="{Binding MusicPlayer.IsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Track info -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MusicPlayer.TrackTitle}"
                                               FontSize="14" FontWeight="600"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="460"
                                               FontFamily="{StaticResource BodyFont}"/>
                                    <TextBlock Text="{Binding MusicPlayer.ChannelTitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"
                                               FontFamily="{StaticResource BodyFont}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MusicPlayer.StatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           FontFamily="{StaticResource BodyFont}"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- WebView2 YouTube player -->
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <wv2:WebView2 x:Name="MusicWebView" DefaultBackgroundColor="#000000"/>
                                </Border>

                                <!-- Playback controls -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding MusicPlayer.PlayPauseButtonText}"
                                                Command="{Binding MusicPlayer.TogglePlayPauseCommand}"
                                                Style="{StaticResource MusicButtonStyle}"/>
                                        <Button Content="⏹ Stop"
                                                Command="{Binding MusicPlayer.StopCommand}"
                                                Style="{StaticResource MusicButtonStyle}"/>
                                        <Button Content="⏭ Skip"
                                                Command="{Binding MusicPlayer.SkipCommand}"
                                                Style="{StaticResource MusicButtonStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MusicPlayer.ErrorMessage}"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="420"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding MusicPlayer.HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                               FontFamily="{StaticResource BodyFont}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Chat scroll content -->
                    <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Messages}" 
                                      ItemTemplate="{StaticResource MessageTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="20,16,20,16"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <ContentControl ContentTemplate="{StaticResource EmptyStateTemplate}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Input area with refined styling -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20"
                    AllowDrop="True" DragOver="InputArea_DragOver" Drop="InputArea_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- V0.63: pending attachment pills -->
                    <ItemsControl Grid.Row="0" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding PendingAttachments}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   MaxWidth="160"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource BodyFont}"/>
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="{StaticResource BodyFont}"/>
                                        <Button Content="✕"
                                                FontSize="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2,0"
                                                Margin="6,0,0,0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Attach button -->
                    <Button Grid.Row="1" Grid.Column="0"
                            VerticalAlignment="Stretch"
                            Width="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="AttachButton_Click"
                            ToolTip="Attach files (or drag and drop)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" Padding="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="📎" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Button>

                    <TextBox x:Name="InputTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Margin="8,0,0,0"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,10"
                             FontSize="13"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             MaxHeight="110"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource BodyFont}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Grid Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" Width="40">
                        <!-- Air streaks trailing the paper plane -->
                        <Border x:Name="StreakTop"
                                Width="9" Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-6,0,0,-7">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="StreakTopTranslate"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="StreakBottom"
                                Width="9" Height="2"
                                CornerRadius="1"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="-6,7,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="StreakBottomTranslate"/>
                            </Border.RenderTransform>
                        </Border>
                        <Grid x:Name="SendButtonHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SendScale"/>
                                    <RotateTransform x:Name="SendRotate"/>
                                    <TranslateTransform x:Name="SendTranslate"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Button Content="&#x2708;"
                                    Command="{Binding SendMessageCommand}"
                                    Style="{StaticResource SendButtonStyle}"
                                    Height="40"
                                    Width="40"
                                    FontSize="18"
                                    Padding="0"
                                    Click="SendButton_Click"
                                    ToolTip="Send message (Enter)"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="9"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           FontFamily="{StaticResource BodyFont}"/>
            </Border>
        </Grid>

        <!-- Version label (V0.63) -->
        <TextBlock Text="v0.63"
                   Grid.Column="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,10,8"
                   FontSize="10"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Opacity="0.7"
                   IsHitTestVisible="False"
                   FontFamily="{StaticResource BodyFont}"/>
    </Grid>
