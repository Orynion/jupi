<Window x:Class="AIOrIsIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saturnia - AI or is it?"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Light Theme Color Palette -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="AccentColor" Color="#5B7FFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4A6EEE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1D23"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="UserMessageBg" Color="#5B7FFF"/>
        <SolidColorBrush x:Key="AIMessageBg" Color="#F3F4F6"/>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Saturnia"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="AI or is it?"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear Chat"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SecondaryBackground}"
                            Foreground="{StaticResource TextPrimary}"
                            Margin="0,0,8,0"/>
                    <Button Content="Settings"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SecondaryBackground}"
                            Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource SecondaryBackground}"
                      Padding="24,16">
            <StackPanel x:Name="ChatPanel">
                <!-- Welcome Message -->
                <Border Background="{StaticResource AIMessageBg}"
                        CornerRadius="12"
                        Padding="16"
                        MaxWidth="600"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Saturnia"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentColor}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Hey, there! This is Saturnia, your experimental AI assistant. Type your message below and let's chat. Type 'exit' if you want to leave."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimary}"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Example User Message -->
                <Border Background="{StaticResource UserMessageBg}"
                        CornerRadius="12"
                        Padding="16"
                        MaxWidth="600"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="You"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.9"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Hello, Saturnia!"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="White"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="{StaticResource PrimaryBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernTextBox}"
                         Height="48"
                         MaxLength="2000"
                         Text=""
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource ModernButton}"
                        Height="48"
                        Margin="12,0,0,0"
                        Padding="32,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
